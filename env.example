# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it's in .gitignore.
# Claude Code will tell you when each key is needed (per the day in PROJECT_PLAN.md).

# ─── Supabase (Day 1) ─────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-side only — used by scripts and Route Handlers. NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Google Gemini (Day 2) ────────────────────────────
# Used for embeddings (text-embedding-004). Get from: aistudio.google.com → Get API Key
GEMINI_API_KEY=AIza...

# ─── Anthropic (Day 3) ────────────────────────────────
# Used for RAG answer generation. Get from: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ─── Self-hosted fine-tune (optional) ─────────────────
# Set GENERATION_MODEL=selfhost:<model-id> to route /api/ask to the fine-tuned
# Gemma served by finetune/serve.py. SELFHOST_URL points at that server's
# /v1/chat/completions; SELFHOST_API_KEY is the shared bearer secret it enforces.
# Leave GENERATION_MODEL unset to keep the Claude default.
# GENERATION_MODEL=selfhost:verselink-gemma
SELFHOST_URL=http://YOUR-GPU-BOX:8000/v1/chat/completions
SELFHOST_API_KEY=

# ─── Vapi (Day 6) ─────────────────────────────────────
# Note: VAPI_MY_PHONE_NUMBER is no longer used — callers enter their own number in the UI.
# Get from: vapi.ai dashboard → API Keys + Phone Numbers + Assistants
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# ─── Vercel Cron Jobs (Day 6) ─────────────────────────
# Shared secret to authenticate cron job calls to /api/cron/*
# Claude Code will generate this on Day 6 — any long random string works.
CRON_SECRET=
